FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    lsb-release \
    ca-certificates \
    && install -d -m 755 /usr/share/keyrings /etc/apt/sources.list.d /etc/apt/preferences.d \
    && curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor --yes -o /usr/share/keyrings/nginx-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] http://nginx.org/packages/mainline/ubuntu jammy nginx" > /etc/apt/sources.list.d/nginx-mainline.list \
    && printf "Package: nginx*\nPin: origin nginx.org\nPin-Priority: 1001\n" > /etc/apt/preferences.d/99-nginx-mainline \
    && apt-get update && apt-get install -y \
    bash \
    nginx \
    sqlite3 \
    python3 \
    wget \
    jq \
    openssl \
    ufw \
    netcat-openbsd \
    psmisc \
    procps \
    tar \
    unzip \
    tzdata \
    dnsutils \
    fail2ban \
    openssh-server \
    unattended-upgrades \
    && rm -rf /var/lib/apt/lists/*

# Create required directories and configure Nginx directories
RUN mkdir -p /etc/nginx/sites-available \
    /etc/nginx/sites-enabled \
    /etc/nginx/stream-enabled \
    /etc/nginx/snippets \
    /var/www/html \
    /root/cert \
    /etc/x-ui \
    /usr/local/x-ui/bin \
    /etc/letsencrypt/live/test.example.com \
    /dev/shm \
    && rm -f /etc/nginx/conf.d/default.conf \
    && grep -q "sites-enabled" /etc/nginx/nginx.conf || sed -i '/conf\.d\/\*\.conf;/a \    include /etc/nginx/sites-enabled/*;' /etc/nginx/nginx.conf

# Create dummy SSL certs for testing (including localhost/127.0.0.1 for browser testing)
RUN openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/letsencrypt/live/test.example.com/privkey.pem \
    -out /etc/letsencrypt/live/test.example.com/fullchain.pem \
    -subj "/CN=localhost" \
    -addext "subjectAltName=DNS:localhost,DNS:test.example.com,IP:127.0.0.1"

# Install real 3x-ui release binary for interactive testing
RUN arch=$(uname -m) && \
    if [ "$arch" = "x86_64" ]; then arch="amd64"; fi && \
    wget -qO /tmp/x-ui.tar.gz https://github.com/MHSanaei/3x-ui/releases/download/v2.9.4/x-ui-linux-${arch}.tar.gz && \
    tar -zxf /tmp/x-ui.tar.gz -C /usr/local/ && \
    chmod +x /usr/local/x-ui/x-ui && \
    rm -f /tmp/x-ui.tar.gz

# Create a minimal x-ui.db for testing
RUN sqlite3 /etc/x-ui/x-ui.db "CREATE TABLE IF NOT EXISTS settings (id INTEGER PRIMARY KEY AUTOINCREMENT, key TEXT NOT NULL, value TEXT NOT NULL); \
    CREATE TABLE IF NOT EXISTS inbounds (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, up INTEGER, down INTEGER, total INTEGER, remark TEXT, enable INTEGER, expiry_time INTEGER, listen TEXT, port INTEGER, protocol TEXT, settings TEXT, stream_settings TEXT, tag TEXT, sniffing TEXT); \
    CREATE TABLE IF NOT EXISTS client_traffics (id INTEGER PRIMARY KEY AUTOINCREMENT, inbound_id INTEGER, enable INTEGER, email TEXT, up INTEGER, down INTEGER, expiry_time INTEGER, total INTEGER, reset INTEGER); \
    INSERT INTO settings (key, value) VALUES ('webPort', '2096'); \
    INSERT INTO settings (key, value) VALUES ('webBasePath', 'asdfasdf');"

# Copy the test script
COPY test_script.sh /test_script.sh
RUN chmod +x /test_script.sh

# Copy interactive test script
COPY interactive_test.sh /interactive_test.sh
RUN chmod +x /interactive_test.sh

# Copy the main script
COPY script.sh /script.sh

CMD ["/test_script.sh"]
