ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
COPY lib/versions.conf /lib/versions.conf

RUN set -eu; \
    . /etc/os-release; \
    . /lib/versions.conf; \
    apt-get update; \
    apt-get install -y curl gnupg ca-certificates; \
    export GNUPGHOME="$(mktemp -d)"; \
    curl -fsSL https://nginx.org/keys/nginx_signing.key -o "$GNUPGHOME/nginx.asc"; \
    gpg --batch --import "$GNUPGHOME/nginx.asc"; \
    gpg --batch --export-options export-minimal --export $NGINX_SIGNING_FINGERPRINTS \
        > /usr/share/keyrings/nginx-archive-keyring.gpg; \
    test -s /usr/share/keyrings/nginx-archive-keyring.gpg; \
    rm -rf "$GNUPGHOME"; \
    printf 'deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/mainline/%s %s nginx\n' \
        "$ID" "$VERSION_CODENAME" > /etc/apt/sources.list.d/nginx-mainline.list; \
    apt-get update; \
    apt-get install -y \
    bash \
    "nginx=${NGINX_VERSION}-1~${VERSION_CODENAME}" \
    sqlite3 \
    python3 \
    python3-systemd \
    python3-pip \
    jq \
    openssl \
    ufw \
    iproute2 \
    netcat-openbsd \
    psmisc \
    procps \
    tar \
    unzip \
    tzdata \
    dnsutils \
    fail2ban \
    openssh-server \
    certbot \
    cron \
    unattended-upgrades; \
    rm -rf /var/lib/apt/lists/*

# Create required directories and configure Nginx directories
COPY lib/probe-requirements.txt /lib/probe-requirements.txt
RUN python3 -m pip install --disable-pip-version-check --no-cache-dir --only-binary=:all: \
    --require-hashes --target /usr/local/lib/vpn-script/probe-packages -r /lib/probe-requirements.txt \
    && sha256sum /lib/probe-requirements.txt | cut -d' ' -f1 > /usr/local/lib/vpn-script/probe-packages/.vpn-script-lock

RUN mkdir -p /etc/nginx/sites-available \
    /etc/nginx/sites-enabled \
    /etc/nginx/stream-enabled \
    /etc/nginx/snippets \
    /var/www/html \
    /root/cert \
    /etc/x-ui \
    /usr/local/x-ui/bin \
    /etc/letsencrypt/live/test.example.com \
    /dev/shm \
    && rm -f /etc/nginx/conf.d/default.conf \
    && { grep -q "sites-enabled" /etc/nginx/nginx.conf || sed -i '/conf\.d\/\*\.conf;/a \    include /etc/nginx/sites-enabled/*;' /etc/nginx/nginx.conf; }

# Create dummy SSL certs for testing (including localhost/127.0.0.1 for browser testing)
RUN openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/letsencrypt/live/test.example.com/privkey.pem \
    -out /etc/letsencrypt/live/test.example.com/fullchain.pem \
    -subj "/CN=localhost" \
    -addext "subjectAltName=DNS:localhost,DNS:test.example.com,IP:127.0.0.1" \
    && cp /etc/letsencrypt/live/test.example.com/fullchain.pem /etc/letsencrypt/live/test.example.com/chain.pem

# Use the same verified 3X-UI and bundled Xray release as the installer.
RUN set -eu; \
    . /lib/versions.conf; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) sha="$PANEL_SHA256_AMD64" ;; \
        arm64) sha="$PANEL_SHA256_ARM64" ;; \
        *) exit 1 ;; \
    esac; \
    archive="$(mktemp)"; \
    curl -fsSL --retry 3 --connect-timeout 10 --max-time 180 "https://github.com/MHSanaei/3x-ui/releases/download/${PANEL_VERSION}/x-ui-linux-${arch}.tar.gz" -o "$archive"; \
    printf '%s  %s\n' "$sha" "$archive" | sha256sum --check --status; \
    install -d /var/cache/vpn-script; \
    cp "$archive" "/var/cache/vpn-script/x-ui-linux-${arch}.tar.gz"; \
    tar -zxf "$archive" -C /usr/local/; \
    rm -f "$archive"; \
    test "$(/usr/local/x-ui/bin/xray-linux-"$arch" version | awk 'NR==1 {print $2}')" = "${XRAY_VERSION#v}"

# Download the same verified geo assets the installer uses for offline tests.
COPY lib/release.sh /lib/release.sh
RUN bash -euc '. /lib/versions.conf; . /lib/release.sh; \
    deployment_error() { printf "%s\n" "$*" >&2; return 1; }; \
    install_geodata /usr/local/x-ui/bin; \
    cp /usr/local/x-ui/bin/geoip.dat "/var/cache/vpn-script/$LOYAL_GEOIP_SHA256.dat"; \
    cp /usr/local/x-ui/bin/geosite.dat "/var/cache/vpn-script/$LOYAL_GEOSITE_SHA256.dat"; \
    cp /usr/local/x-ui/bin/geosite_RU.dat "/var/cache/vpn-script/$RUNET_GEOSITE_SHA256.dat"'

RUN mkdir -p /etc/vpn-qa-doh && openssl req -x509 -nodes -days 365 -newkey ec \
    -pkeyopt ec_paramgen_curve:prime256v1 -subj '/CN=xbox-dns.ru' \
    -addext 'subjectAltName=DNS:xbox-dns.ru,DNS:eu.geohide.ru,DNS:dns.comss.one,DNS:classic.qa.test,DNS:classic-alt.qa.test' \
    -keyout /etc/vpn-qa-doh/key.pem -out /etc/vpn-qa-doh/cert.pem

# Copy the test script
COPY test_script.sh /test_script.sh
RUN chmod +x /test_script.sh

# Copy interactive test script
COPY interactive_test.sh /interactive_test.sh
RUN chmod +x /interactive_test.sh

# Copy the main script
COPY script.sh /script.sh
COPY audit.sh /audit.sh
COPY lib/ /lib/
COPY tests/ /tests/

CMD ["/test_script.sh"]
